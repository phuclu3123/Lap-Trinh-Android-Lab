<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Runtime Preference definitions. For visual preview, open res/layout/activity_settings.xml. -->

    <PreferenceCategory android:title="@string/category_personal">
        <EditTextPreference
            android:key="pref_name"
            android:title="@string/pref_name_title"
            android:defaultValue="Lữ Võ Hoàng Phúc"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="pref_gender"
            android:title="@string/pref_gender_title"
            android:entries="@array/gender_entries"
            android:entryValues="@array/gender_values"
            android:defaultValue="male"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="pref_age"
            android:title="@string/pref_age_title"
            android:defaultValue="22"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="pref_birthday"
            android:title="@string/pref_birthday_title"
            android:defaultValue="01/01/2004"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_contact">
        <EditTextPreference
            android:key="pref_email"
            android:title="@string/pref_email_title"
            android:defaultValue="phuc@example.com"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="pref_phone"
            android:title="@string/pref_phone_title"
            android:defaultValue="0900 000 000"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="pref_city"
            android:title="@string/pref_city_title"
            android:entries="@array/city_entries"
            android:entryValues="@array/city_values"
            android:defaultValue="TP. Hồ Chí Minh"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_privacy">
        <SwitchPreferenceCompat
            android:key="pref_public"
            android:title="@string/pref_public_title"
            android:defaultValue="true"
            android:summaryOn="@string/pref_public_summary_on"
            android:summaryOff="@string/pref_public_summary_off" />
    </PreferenceCategory>
</PreferenceScreen>
