<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Buoi_8_BTVN_Lab_10" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/profile_primary</item>
        <item name="colorPrimaryVariant">@color/profile_primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/profile_primary</item>
        <item name="colorSurface">@color/profile_surface</item>
        <item name="colorOnSurface">@color/profile_text_primary</item>
        <item name="android:colorBackground">@color/profile_background</item>
        <item name="colorOnBackground">@color/profile_text_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:navigationBarColor">@color/profile_surface</item>
        <item name="android:statusBarColor">@color/profile_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Buoi_8_BTVN_Lab_10" parent="Base.Theme.Buoi_8_BTVN_Lab_10" />

    <style name="SettingsPreviewCategory">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/profile_primary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsPreviewRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <style name="SettingsPreviewRowHorizontal" parent="SettingsPreviewRow">
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingsPreviewTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/profile_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsPreviewSummary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/profile_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
