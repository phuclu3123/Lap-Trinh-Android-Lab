<?xml version="1.0" encoding="utf-8"?>

<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="3"
    android:padding="10dp">


    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="wrap_content"
        android:layout_height="100dp"

        android:layout_row="0"
        android:layout_column="0"

        android:ems="10"
        android:inputType="text"
        android:text="Tên hàng" />


    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="wrap_content"
        android:layout_height="103dp"

        android:layout_row="1"
        android:layout_column="0"

        android:ems="10"
        android:inputType="text"
        android:text="Đơn giá" />

    <EditText
        android:id="@+id/editTextText6"
        android:layout_width="wrap_content"
        android:layout_height="100dp"

        android:layout_row="2"
        android:layout_column="0"

        android:ems="10"
        android:inputType="text"
        android:text="Hàng dễ vỡ" />


    <EditText
        android:id="@+id/editTextText9"
        android:layout_width="wrap_content"
        android:layout_height="82dp"

        android:layout_row="3"
        android:layout_column="0"

        android:ems="10"
        android:inputType="text"
        android:text="Thời gian bảo hành" />


    <EditText
        android:id="@+id/editTextText10"
        android:layout_width="wrap_content"
        android:layout_height="100dp"

        android:layout_row="4"
        android:layout_column="0"

        android:ems="10"
        android:inputType="text"
        android:text="Xuất xứ (Country)" />



    <!--
        TÊN HÀNG

        Palette:
        Text -> Plain Text (EditText)

        background="@android:drawable/edit_text"
        -> làm ô nhập nhìn giống hình chữ nhật

        padding="8dp"
        -> tạo khoảng cách giữa chữ và viền ô
    -->

    <EditText
        android:id="@+id/editTextText4"
        android:layout_width="182dp"
        android:layout_height="100dp"

        android:layout_row="0"
        android:layout_column="1"

        android:ems="10"
        android:inputType="text"
        android:text=""

        android:padding="8dp"
        android:background="@android:drawable/edit_text" />



    <!--
        ĐƠN GIÁ

        Palette:
        Text -> Plain Text (EditText)

        Nếu sau này muốn chỉ nhập số:
        android:inputType="numberDecimal"

        Hiện tại chỉ làm UI nên để text cũng được.
    -->

    <EditText
        android:id="@+id/editTextText7"
        android:layout_width="182dp"
        android:layout_height="100dp"

        android:layout_row="1"
        android:layout_column="1"

        android:background="@android:drawable/edit_text"
        android:ems="10"
        android:inputType="text"
        android:padding="8dp"
        android:text="" />



    <!--
        HÀNG DỄ VỠ

        Palette:
        Buttons / Widgets -> Switch

        Switch có 2 trạng thái:
        False / True

        textOff="F" -> khi tắt
        textOn="T"  -> khi bật

        showText="true"
        -> cho phép hiện chữ F / T

        checked="false"
        -> trạng thái ban đầu là False
    -->


    <!--
        THỜI GIAN BẢO HÀNH

        Palette:
        Widgets -> SeekBar

        progress="0"
        -> giá trị ban đầu = 0

        max="24"
        -> giá trị lớn nhất = 24

        => Thanh kéo chạy từ 0 đến 24
    -->


    <!--
        XUẤT XỨ

        Palette:
        Widgets -> Spinner

        Spinner = danh sách xổ xuống

        Ví dụ sau này có thể chứa:
        Việt Nam
        Mỹ
        Nhật Bản
        Hàn Quốc
        ...
    -->

    <Switch
        android:id="@+id/switch1"
        android:layout_width="162dp"
        android:layout_height="97dp"

        android:layout_row="2"
        android:layout_column="1"

        android:checked="false"

        android:showText="true"
        android:text=""
        android:textOff="F"
        android:textOn="T" />

    <LinearLayout
        android:layout_width="162dp"
        android:layout_height="82dp"
        android:layout_row="3"
        android:layout_column="1"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0"
                android:textAlignment="viewStart" />

            <TextView
                android:layout_width="65dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="24"
                android:textAlignment="viewEnd" />

        </LinearLayout>

    </LinearLayout>

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="173dp"
        android:layout_height="88dp"

        android:layout_row="4"
        android:layout_column="1" />




    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_row="5"
        android:layout_column="0"

        android:text="Thêm" />


    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_row="5"
        android:layout_column="1"

        android:text="Xóa" />


</GridLayout>